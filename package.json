{
  "name": "motif-capture",
  "version": "0.0.0",
  "private": true,
  "description": "Mobile-first humming motif capture and melody normalization MVP.",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev:api": "cd services/api && . .venv/bin/activate && uvicorn app.main:app --reload --port 8000",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "pnpm --filter web test && cd services/api && . .venv/bin/activate && pytest",
    "test:api": "cd services/api && . .venv/bin/activate && pytest",
    "test:web": "pnpm --filter web test",
    "typecheck": "pnpm --filter web typecheck"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
